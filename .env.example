# -----------------------------------------------------------------------------
# Next.js app / Prisma
# -----------------------------------------------------------------------------
# Used by Next.js runtime and Prisma when you run outside Docker (e.g. `npm run dev`).
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kenzerama?schema=public

# Optional: docker-compose `web` service only. If set, it becomes the container `DATABASE_URL`
# (Prisma) before `DATABASE_URL` is applied — use for hosted Postgres `insta` while Directus
# uses local `kenzerama` in Docker. Example: same DSN as staging Prisma / Instagram DB.
# INSTA_DATABASE_URL=postgresql://USER:PASS@HOST:PORT/insta?schema=public

# Optional compose override used by docker-compose.yml for the `web` service.
# Keep this equal to DATABASE_URL unless you intentionally want a different DSN.
APP_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kenzerama?schema=public

# Next app -> Directus API endpoint.
# In Docker network: http://directus:8055
# In production: your public Directus URL.
DIRECTUS_URL=http://directus:8055
# Static token or CI-minted admin access token for server-side Directus reads.
DIRECTUS_TOKEN=
# Browser-facing Directus origin for asset URLs; keep aligned with DIRECTUS_URL at build time.
NEXT_PUBLIC_DIRECTUS_URL=http://directus:8055

# -----------------------------------------------------------------------------
# Directus core/auth
# -----------------------------------------------------------------------------
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me
DIRECTUS_KEY=replace-with-long-random-key
DIRECTUS_SECRET=replace-with-long-random-secret

# -----------------------------------------------------------------------------
# Directus DB connection
# Use either split DIRECTUS_DB_* vars OR DIRECTUS_DATABASE_URL.
# -----------------------------------------------------------------------------
DIRECTUS_DB_CLIENT=pg
DIRECTUS_DB_HOST=postgres
DIRECTUS_DB_PORT=5432
DIRECTUS_DB_DATABASE=kenzerama
DIRECTUS_DB_USER=postgres
DIRECTUS_DB_PASSWORD=postgres

# Optional single URL form (if you prefer it in your deploy setup).
DIRECTUS_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/kenzerama

# -----------------------------------------------------------------------------
# Optional Directus Redis (for caching/queues)
# -----------------------------------------------------------------------------
DIRECTUS_REDIS_ENABLED=false
DIRECTUS_REDIS=redis://redis:6379

# -----------------------------------------------------------------------------
# Mux video extension (directus/extensions/jpp-mux-video)
# Create an access token at https://dashboard.mux.com/settings/access-tokens
# with the "Mux Video" permission ("Read" + "Write" on the Video API).
# -----------------------------------------------------------------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Allow the extension's API endpoints to be reached from the Directus app.
# The endpoint name `mux` exposes routes at /mux/* (e.g. /mux/uploads).
# Add these under EXTENSIONS_PATH or rely on the default endpoints loader.
DIRECTUS_EXTENSIONS_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Existing app-specific variables (isolated from Directus config)
# -----------------------------------------------------------------------------
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=
INSTAGRAM_APP_TOKEN=
CRON_SECRET=
REVALIDATE_SECRET=

# Public app metadata
NEXT_PUBLIC_APP_NAME=Kenzerama Productions
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_APP_DESCRIPTION_SHORT=Wedding Videographers
SN_SRC_URL=

# Optional build/debug toggles
ANALYZE=false
